// Firestore rules for SWGOH schedule push subscriptions.
//
// Collection: push_subscriptions/{fcm-token}
//   { categories: ["marquee", ...], updatedAt: <ms> }
//
// Any device may create/update ONLY its own subscription document (the
// document ID is its private FCM token, which acts as the write key).
// Nobody reads or deletes through the client SDK — the CI sender uses
// the service-account secret instead. Paste into:
//   Firebase Console → Firestore Database → Rules → Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /push_subscriptions/{token} {
      allow create, update: if true;
      allow read, delete: if false;
    }
  }
}
